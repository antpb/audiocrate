# Dependencies
node_modules/

# Package build output (published to npm from a fresh build, never committed).
# Anchored so examples/*/wasm/dist stays trackable.
/dist/
editor/dist/
*.tsbuildinfo

# Tooling caches
.cache/
.vite/
.vite-temp/
.eslintcache
coverage/
.nyc_output/

# npm pack / local tarballs
*.tgz

# Secrets and local config
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp

# Example WASM object dirs. Committed artefacts live in wasm/dist.
examples/**/wasm/build/
examples/**/wasm/build-fx/

# SwiftPM (examples/CrateASL)
.build/
.swiftpm/
Package.resolved

# OS junk
.DS_Store
._*
Thumbs.db
