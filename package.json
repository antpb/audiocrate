{
  "name": "audiocrate",
  "version": "0.2.1",
  "description": "A scene graph and AudioMaterial system for audio, organized like three.js. Serialisable DSP that the same interpreter runs offline and in an AudioWorklet.",
  "keywords": [
    "audio",
    "web-audio",
    "webaudio",
    "audioworklet",
    "dsp",
    "synthesis",
    "audio-engine",
    "scene-graph",
    "music",
    "daw",
    "signal-processing",
    "music-theory",
    "three.js"
  ],
  "license": "MIT",
  "author": "Anthony Burchell",
  "homepage": "https://homecrate.app/docs/crate/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antpb/audiocrate.git"
  },
  "bugs": {
    "url": "https://github.com/antpb/audiocrate/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theory": {
      "types": "./dist/theory/index.d.ts",
      "default": "./dist/theory/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "default": "./dist/collab/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial/index.d.ts",
      "default": "./dist/spatial/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./worklet": "./dist/crate-voice-processor.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:worklet && npm run build:js && npm run build:types",
    "build:worklet": "node scripts/build-worklet.mjs",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "editor": "vite --config editor/vite.config.ts",
    "editor:build": "vite build --config editor/vite.config.ts",
    "example:xr": "vite build --config examples/xr/vite.config.ts && vite --config examples/xr/demo/vite.config.ts",
    "test:editor": "vitest run --config editor/vitest.config.ts",
    "fixtures:materials": "esbuild editor/scripts/emit-material-catalog.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/emit-material-catalog.mjs && node node_modules/.cache/emit-material-catalog.mjs examples/CrateASL/Sources/CrateASL/Resources/material-catalog.json",
    "fixtures:flatten": "esbuild editor/scripts/emit-flatten-fixtures.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/emit-flatten-fixtures.mjs && node node_modules/.cache/emit-flatten-fixtures.mjs fixtures/flatten-conformance.json",
    "test:examples": "vitest run --config examples/amp/vitest.config.ts --dir examples/amp && vitest run --config examples/drum/vitest.config.ts --dir examples/drum && vitest run --config examples/grain/vitest.config.ts --dir examples/grain && vitest run --config examples/synth/vitest.config.ts --dir examples/synth && vitest run --config examples/space-reverb/vitest.config.ts --dir examples/space-reverb && vitest run --config examples/xr/vitest.config.ts --dir examples/xr",
    "test:swift": "/usr/bin/swift test --package-path examples/CrateASL",
    "prepublishOnly": "npm run test && npm run build && npm run verify:package"
  },
  "devDependencies": {
    "@antpb/xr-publisher": "^0.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "p2pcf": "^1.3.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.3.2",
    "rete-connection-plugin": "^2.0.5",
    "rete-react-plugin": "^2.1.2",
    "rete-render-utils": "^2.0.3",
    "styled-components": "^6.5.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
